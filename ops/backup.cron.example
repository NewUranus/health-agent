# 示例：由部署方安装到受控主机，口令文件权限 600；不会自动安装或执行。
# 目录、Python 路径、保留周期与异地复制由部署方确定。
0 2 * * * cd /srv/healthpilot && .venv/bin/python -m app.maintenance backup --passphrase-file /run/secrets/backup-passphrase --output /srv/backups/healthpilot-$(date +\%Y\%m\%d-\%H\%M\%S).gpg >> /var/log/healthpilot-backup.log 2>&1
